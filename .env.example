# Yoga Studio — copy to .env and fill in local values.
# Never commit real credentials.

# --- App ---
NODE_ENV=development
APP_NAME=Yoga Studio
APP_URL=http://yogastudio.airepro.in:2004
API_PORT=2005
FRONTEND_ORIGIN=http://yogastudio.airepro.in:2004,http://localhost:2004

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-32-character-or-longer-secret
JWT_TIMEOUT=30d
BCRYPT_ROUNDS=10

# --- MySQL ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_USERNAME=yoga
DATABASE_PASSWORD=yoga
DATABASE_NAME=yoga_studio

# --- File storage (local disk; swap for object storage in production) ---
MEDIA_STORAGE_DIR=./storage/media
# Path-absolute /media works with Vite proxy and same-origin nginx.
MEDIA_PUBLIC_BASE_URL=/media

# --- Fable 5 / Anthropic Messages API ---
# Official auth is ANTHROPIC_API_KEY (x-api-key header).
# FABLE_API_KEY is accepted as an alias so ops can name it after the model.
# Docs: https://platform.claude.com/docs/en/api/messages
# Model IDs: https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_API_KEY=
FABLE_API_KEY=
FABLE_API_BASE_URL=https://api.anthropic.com
FABLE_MODEL=claude-fable-5-1
FABLE_ANTHROPIC_VERSION=2023-06-01
FABLE_EFFORT=medium
FABLE_MAX_TOKENS=8192

# Optional server-side refusal fallback (beta). Leave empty to disable.
# Docs: https://platform.claude.com/docs/en/build-with-claude/refusals-and-fallback
FABLE_FALLBACK_MODEL=

# --- Generation jobs ---
GENERATION_POLL_MS=1500
GENERATION_MAX_RETRIES=3
GENERATION_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_MAX=30

# --- Logging ---
LOG_LEVEL=info
