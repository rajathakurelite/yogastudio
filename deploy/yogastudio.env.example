# Copy to /home/airepro/.secrets/yogastudio.env on the Jenkins agent.
# chmod 600. Never commit real secrets.
#
# IMPORTANT for Docker --env-file:
# - Do NOT wrap values in quotes. Docker keeps the quote characters.
#   BAD:  DATABASE_PASSWORD='&P}Gk3eK,k{i5dTX'
#   GOOD: DATABASE_PASSWORD=&P}Gk3eK,k{i5dTX
#
# IMPORTANT for Remote MySQL (pole.hostitbro.com / cPanel):
# - Add the Jenkins server public IP under "Remote MySQL Access"
#   (the deploy log prints: Jenkins egress IP …).
# - Host Access Host can be % or the specific Jenkins IP.

NODE_ENV=production
API_PORT=2005
APP_URL=https://yogastudio.airepro.in
FRONTEND_ORIGIN=https://yogastudio.airepro.in,http://yogastudio.airepro.in:2004

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_TIMEOUT=30d
BCRYPT_ROUNDS=10

DATABASE_HOST=pole.hostitbro.com
DATABASE_PORT=3306
DATABASE_USERNAME=elitepro_yoga
DATABASE_PASSWORD=replace-me
DATABASE_NAME=elitepro_yoga

MEDIA_STORAGE_DIR=./storage/media
# Prefer /media when nginx proxies the UI host; use absolute API URL for split hosts.
MEDIA_PUBLIC_BASE_URL=/media

ANTHROPIC_API_KEY=
FABLE_API_KEY=
FABLE_API_BASE_URL=https://api.anthropic.com
FABLE_MODEL=claude-fable-5-1
FABLE_ANTHROPIC_VERSION=2023-06-01
FABLE_EFFORT=medium
FABLE_MAX_TOKENS=8192

GENERATION_POLL_MS=1500
GENERATION_MAX_RETRIES=3
GENERATION_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_MAX=30
LOG_LEVEL=info
